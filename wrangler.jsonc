{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lastro",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://lastro.feraimentor.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://heideeuesoyiryooadcb.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_zuR1PhGsWHWcwb350TsTZA_OJABCKTl"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *", "0 12 * * *"]
  }
}
